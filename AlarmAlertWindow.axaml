<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AnalogClock.AlarmAlertWindow"
        SystemDecorations="None"
        CanResize="False"
        Topmost="True"
        WindowStartupLocation="CenterOwner"
        Width="400" Height="200"
        Background="#FF2D2D2D">
  <Grid>
    <TextBlock x:Name="DescriptionText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" Foreground="White" TextWrapping="Wrap" Margin="20" />
    <Border x:Name="StopButton" Background="#FF555555" Padding="15,8" CornerRadius="4" Cursor="Hand" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20">
      <TextBlock Text="Wecker aus" Foreground="White" FontSize="16" />
    </Border>
  </Grid>
</Window>
