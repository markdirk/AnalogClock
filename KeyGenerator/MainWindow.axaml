<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AnalogClock.KeyGenerator.MainWindow"
        Title="AnalogClock KeyGenerator"
        Width="1100"
        Height="600"
        MinWidth="800"
        MinHeight="400"
        CanResize="True"
        Background="#FF2D2D2D">

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="10">
            <TextBlock Text="Anzahl:" Foreground="White" VerticalAlignment="Center" />
            <TextBox x:Name="CountBox" Text="1" Width="60" Foreground="White" Background="#FF3D3D3D" CaretBrush="White" VerticalAlignment="Center" />
            <Button x:Name="GenerateButton" Content="Generieren" Foreground="White" Background="#FF555555" />
            <Button x:Name="SaveButton" Content="Speichern" Foreground="White" Background="#FF555555" />
            <Button x:Name="RestoreBackupButton" Content="Backup wiederherstellen" Foreground="White" Background="#FF555555" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="10,0">
            <TextBlock x:Name="StatusText" Text="Bereit" Foreground="White" VerticalAlignment="Center" />
            <TextBox x:Name="SearchBox"
                     Grid.Column="1"
                     Watermark="Suchen (Kunde, Rechnungsnr., ...)"
                     Width="300"
                     Foreground="White"
                     Background="#FF3D3D3D"
                     CaretBrush="White" />
        </Grid>

        <Border Grid.Row="2" Background="#FF3D3D3D" Margin="10" Padding="5" CornerRadius="3"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <DataGrid x:Name="RecordsGrid"
                      AutoGenerateColumns="False"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      IsReadOnly="False"
                      GridLinesVisibility="All"
                      Background="#FF3D3D3D"
                      Foreground="White"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Lizenzschlüssel" Binding="{Binding Key, Mode=OneWay}" IsReadOnly="True" Width="360" CanUserSort="True" />
                    <DataGridTextColumn Header="Erzeugt am" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm, Mode=OneWay}" IsReadOnly="True" Width="165" CanUserSort="True" />
                    <DataGridTextColumn Header="Kunde" Binding="{Binding CustomerName, Mode=TwoWay}" Width="*" CanUserSort="True" />
                    <DataGridTextColumn Header="Rechnungsnr." Binding="{Binding InvoiceNumber, Mode=TwoWay}" Width="*" CanUserSort="True" />
                    <DataGridTextColumn Header="Rechnungspos." Binding="{Binding InvoicePosition, Mode=TwoWay}" Width="*" CanUserSort="True" />
                    <DataGridTemplateColumn Header="" Width="70" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="&#x1F4CB;" Click="CopyButton_Click" Background="#FF555555" Foreground="White" Padding="4,2"
                                        ToolTip.Tip="In Zwischenablage kopieren" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="3" x:Name="RecordCountText" Text="0 Schlüssel" Foreground="White" HorizontalAlignment="Right" Margin="10" />
    </Grid>
</Window>
